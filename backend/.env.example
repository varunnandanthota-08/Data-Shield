# DataShield AI Backend Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
DEBUG=true

# CORS Origins (comma-separated or list in config)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional AI Engine Key (Gemini API key is read from env if available)
GEMINI_API_KEY=
