# DataShield AI Environment Configuration
# Mode: "development", "staging", or "production"
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8001
DEBUG=true

# Database Persistence Path
# Relative paths are anchored deterministically to backend/ to prevent accidental selection of obsolete root databases.
# Development default: "datashield.db" (resolves to backend/datashield.db)
# Staging default: "datashield_staging.db" (resolves to backend/datashield_staging.db)
SQLITE_DB_PATH=datashield.db

# CORS Allowed Origins (JSON array or comma-separated list)
# Note: Wildcard '*' is disallowed when allow_credentials=True in production/staging
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Cryptography
# In production, JWT_SECRET_KEY must be a cryptographically secure random secret (min 32 characters)
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=datashield-dev-jwt-secret-replace-in-production-2026-secure-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Proxy Configuration
# RATE_LIMIT_STORAGE_BACKEND: "sqlite" (shared multi-worker support) or "memory" (single-process test)
RATE_LIMIT_STORAGE_BACKEND=sqlite
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300
SCAN_RATE_LIMIT_PER_MINUTE=60
TRUST_FORWARDED_FOR=false
TRUSTED_PROXIES=["127.0.0.1","::1"]

# User Account Provisioning Policy
# ALLOW_PUBLIC_REGISTRATION: false (Enterprise Zero-Trust default: Administrator provisions users)
# Set to true only in environments where open self-registration with Viewer role is permitted
ALLOW_PUBLIC_REGISTRATION=false

# Optional Google Gemini AI Advisory Layer
# If unset, DataShield AI functions seamlessly with deterministic security enforcement and local explanations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10.0
GEMINI_MAX_RETRIES=2
